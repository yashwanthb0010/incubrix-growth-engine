# IncuBrix Social Media Content Engine Environment Configuration
# Copy this file to .env and configure as needed.

# Application Environment (development / production / demo)
APP_ENV=development

# LLM Provider: 'demo' (deterministic local mode, no API key needed), 'openai', 'anthropic', 'gemini'
LLM_PROVIDER=demo

# OpenAI API Key (Required only if LLM_PROVIDER=openai)
OPENAI_API_KEY=

# Anthropic API Key (Required only if LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=

# Google Gemini API Key (Required only if LLM_PROVIDER=gemini)
GEMINI_API_KEY=

# Default Model Name (e.g. gpt-4o-mini, claude-3-5-sonnet, gemini-1.5-flash)
LLM_MODEL=demo-mode-engine-v1

# Media Rendering Engine (imageio-ffmpeg / opencv)
RENDER_ENGINE=imageio-ffmpeg

# SQLite Database Path
DATABASE_PATH=data/incubrix.db
